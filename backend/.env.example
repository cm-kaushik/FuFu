# Database Configuration (For TiDB Cloud, Aiven, or local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=stock_app
DB_SSL=false

# Authentication & JWT
SECRET_KEY=generate_a_random_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Trading Security PIN
TRADE_PIN=2468

# AI & Data APIs
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
NEWS_API_KEY=your_news_api_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# Frontend Allowed Origins (Comma-separated for strict CORS, or leave empty for all)
ALLOWED_ORIGINS=
